DISCORD_TOKEN=
DATABASE_URL=postgres://graphite:graphite@localhost:5432/graphite
GRAPHITE_IDENTITY_HMAC_KEY_HEX=replace-with-at-least-32-random-bytes-in-hex

# Optional. Configure all three together to publish a current Terms of Service version.
GRAPHITE_TOS_VERSION=1
GRAPHITE_TOS_URL=https://example.invalid/graphite/tos/v1
GRAPHITE_TOS_SHA256_HEX=replace-with-64-hex-characters

# Optional. Register slash commands in one guild for fast development propagation.
GRAPHITE_DEV_GUILD_ID=

RUST_LOG=graphite_bot=info,graphite_store=info
